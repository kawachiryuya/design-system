{
  "name": "@kawachiryuya/design-system",
  "version": "0.6.0",
  "description": "Storybook を Single Source of Truth とする React コンポーネントライブラリ — Parts (primitives) / Blocks (composites) と semantic トークン",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawachiryuya/design-system.git"
  },
  "homepage": "https://design-system-storybook-murex.vercel.app",
  "exports": {
    ".": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens/preset": {
      "default": "./tokens/preset.cjs"
    },
    "./tokens/variables.css": "./tokens/build/variables.css",
    "./principles/*": "./principles/*",
    "./AGENTS.md": "./AGENTS.md"
  },
  "files": [
    "dist",
    "tokens/preset.cjs",
    "tokens/build/variables.css",
    "tokens/build/tokens.json",
    "principles",
    "AGENTS.md",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "scripts": {
    "tokens:build": "style-dictionary build --config style-dictionary.config.js",
    "tokens:watch": "style-dictionary build --config style-dictionary.config.js --watch",
    "tokens:typecheck": "tsc -p tsconfig.tokens.json",
    "build": "npm run tokens:build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prestorybook": "npm run tokens:build",
    "prebuild-storybook": "npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-mcp": "^0.4.2",
    "@storybook/react": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.3",
    "storybook-addon-pseudo-states": "^10.4.2",
    "style-dictionary": "^5.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
